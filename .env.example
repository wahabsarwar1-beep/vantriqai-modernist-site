# VantriqAI chat widget (@n8n/chat) — production webhook, CORS-restricted to
# https://vantriqai.com and https://www.vantriqai.com. Set the same value in
# the host's env settings (Hostinger: hPanel -> Node.js -> Environment variables).
#
# This points at the SELF-HOSTED n8n on the VPS, not n8n Cloud. The workflow is
# "Vantriq — Website Assistant (vantriqai.com)"; the id in the path is the chat
# trigger's webhookId, which survived the import from Cloud, so the two
# instances answer on the same path. Only one of them should be running the
# assistant — the VPS one, per the business model, since Cloud is metered.
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://n8n.vantriqai.com/webhook/678305e8-7b54-4a7f-9a04-4662389631b2/chat

# Contact form ("Send a brief" on /contact) → the CRM pipeline.
# The brief is filed as a lead tagged "Website Brief", and the CRM emails the
# team itself. Both are server-only (no NEXT_PUBLIC_ prefix): the key can write
# to the pipeline, so it must never reach the browser bundle.
#
# The key is a WEBHOOK-scoped CRM key, not the admin key:
#   docker exec crm_app npm run create-key -- "Website brief form" webhook
CRM_WEBHOOK_URL=https://crm.vantriqai.com
CRM_WEBHOOK_KEY=

# Optional second copy of each brief, in a Google Sheet.
# Google Apps Script web app URL — see docs/contact-form-google-sheet.md.
# Leave unset (or as REPLACE_ME) to skip it; the CRM is the record either way,
# so a Sheet outage never costs a brief.
CONTACT_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
