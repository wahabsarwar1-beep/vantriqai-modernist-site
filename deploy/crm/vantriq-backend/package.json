{
  "name": "vantriq-crm-backend",
  "version": "9.24.2",
  "description": "Vantriq AI \u2014 CRM, billing, procurement, and usage-ingestion API backed by Postgres/Supabase",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/utils/migrate.js",
    "create-key": "node src/utils/createKey.js",
    "create-user": "node src/utils/createUser.js",
    "test:webhooks": "node test/webhooks-lead.test.js",
    "seed-internal": "node src/utils/seedInternal.js",
    "seed-owner": "node src/utils/seedOwner.js",
    "survey-smoke": "node src/utils/surveySmokeTest.js",
    "docs:api": "node tools/gen-api-docs.js",
    "test:proposal": "node test/proposal.test.js",
    "test:app": "node test/app.test.js",
    "test:report": "node test/report.test.js",
    "test:customers": "node test/contacts.test.js && node test/customers-ui.test.js",
    "test:echo": "node test/echo-dashboard.test.js",
    "test:templates": "node test/templates.test.js && node test/templates-ui.test.js",
    "test:surveys": "node test/surveys.test.js && node test/survey-access.test.js && node test/after-chat.test.js && node test/own-survey.test.js && node test/surveys-ui.test.js",
    "test:costing": "node test/costing.test.js",
    "test:calendar": "node test/calendar.test.js && node test/calendar-ui.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "qrcode-generator": "^1.5.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "playwright-core": "^1.63.0"
  }
}
