    {
      "id": "34ab0e01-1e26-484a-8bf3-710b5eef6148",
      "name": "Work out the billing period",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = new Date();\nconst prev = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1));\nconst month = prev.toISOString().slice(0, 10);\nconst period = prev.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });\nreturn [{ json: { month, period } }];"
      }
    },
    {
      "id": "078cec25-e878-43a0-b920-2045341b3505",
      "name": "Get active clients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        20,
