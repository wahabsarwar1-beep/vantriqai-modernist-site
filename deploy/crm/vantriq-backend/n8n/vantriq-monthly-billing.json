  "nodes": [
    {
      "id": "94433314-07fc-4cad-a480-c4f4c1d9cf2b",
      "name": "First of the month, 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -420,
