# ---------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------

# Supabase (or any Postgres) connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" URI if deploying to a serverless host)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# If your provider requires SSL (Supabase does), leave this as true.
DATABASE_SSL=true

# Port the API listens on (most hosts override this automatically)
PORT=8080

# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the URL where you host public/index.html once deployed.
CORS_ORIGIN=*

# ---------------------------------------------------------------------
# Internal employee sign-in (v3): password + a one-time code emailed to
# the employee. Without these two values nobody can complete a sign-in,
# so set them before switching staff over.
# hPanel -> Emails -> API tokens
# ---------------------------------------------------------------------
HOSTINGER_MAIL_TOKEN=
HOSTINGER_MAILBOX_ID=AC639077da6944831097970eb520d3
# The sender is whichever mailbox HOSTINGER_MAILBOX_ID names — the Hostinger
# API takes no `from`. This is only the display name beside the address.
MAIL_DISPLAY_NAME=Vantriq AI
# Where 'tell the team' automations send. Not the sender address.
TEAM_NOTIFY_EMAIL=support@vantriqai.com

# Only addresses on this domain may hold an internal login.
COMPANY_EMAIL_DOMAIN=vantriqai.com

# Break-glass: the admin API key keeps working as an emergency way in.
# Set to false once everyone has an account and email delivery is proven.
ALLOW_API_KEY_LOGIN=true
