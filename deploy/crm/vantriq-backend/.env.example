# ---------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------

# Supabase (or any Postgres) connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Transaction pooler" URI if deploying to a serverless host)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# If your provider requires SSL (Supabase does), leave this as true.
DATABASE_SSL=true

# Port the API listens on (most hosts override this automatically)
PORT=8080

# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the URL where you host public/index.html once deployed.
CORS_ORIGIN=*
